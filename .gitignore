# Build artifacts (the release ZIP is built outside the repo, but ignore any local copy)
*.zip
Mod_Accesibilidad_Pokemon_*.zip

# Runtime files generated inside a deployed game's accessibility/data folder
settings.ini
diag.txt
hook_loaded.txt
loader_error.txt
tags_export.txt
tags_import.txt

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Editor
*.swp
*~

# graphify analysis output (local only)
graphify-out/

# native build output and fetched third-party deps (miniaudio.h, Steam Audio SDK)
native/out/
native/miniaudio.h
native/sdk/

# games source folder, for debugging and developing of new script.
# do not upload these things
games_src/

# debug folder. for store diagnostics files, on the fly scripts, and whatever what you use during a debugging process.
debug/


# Test-runner sandbox (Paths::DATA resolves here when the suite runs from the repo root)
accessibility/

# Local builds of the prism bridge (distributables go to assets/ when the swap lands)
bridge/out/


# Config local de Claude Code: privada, no se comparte.
.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# MCP local (graft): va con .claude/, no se comparte.
.mcp.json
.ignore

# Informes de auditoria: viven fuera del repo (../../auditoria/). Al repo solo va el mod.
/auditoria/

# Runtime markers the test harness writes (redirected via POKEACCESS_DATA_DIR)
test/tmp_data/

# Scratch folders of the installer specs (removed in ensure; only an interrupted run leaves them)
test/static/tmp_ps_fn/
test/static/tmp_fake_game/
